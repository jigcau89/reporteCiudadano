{
  "expo": {
    "name": "Reporte Ciudadano",
    "slug": "reporte-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reporteciudadano",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "ar.gob.gchu.reporteciudadano"
    },
    "android": {
      "package": "ar.gob.gchu.reporteciudadano",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#007BFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBm_n68Kib_6AxiVzuSutMK359Zo3vlTa4"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Reporte Ciudadano necesita usar la cámara para tomar la foto obligatoria del reclamo y escanear códigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reporte Ciudadano necesita tu ubicación para georreferenciar el problema en Gualeguaychú."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reporte Ciudadano necesita acceso a tu galería para adjuntar fotografías del problema o del arreglo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite el reingreso rápido con biometría."
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-sqlite",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8467573f-5f75-4c17-a2f5-73ccf81ba1e2"
      }
    },
    "owner": "jigcau89"
  }
}